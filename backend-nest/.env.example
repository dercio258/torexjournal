# ==============================================
# TOREX JOURNAL - BACKEND ENVIRONMENT TEMPLATE
# ==============================================
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=CHANGE_ME
DB_NAME=trading_cossa
DB_SYNCHRONIZE=false

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_PREFIX={cossa_trading}

# --- ClickHouse ---
CLICKHOUSE_HOST=http://127.0.0.1:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=CHANGE_ME
CLICKHOUSE_DATABASE=default

# --- Security & Admin (Domain-Segregated Secrets) ---
JWT_SECRET=CHANGE_ME_USER_JWT_SECRET_MIN_32_CHARS
USER_JWT_SECRET=
ADMIN_JWT_SECRET=CHANGE_ME_ADMIN_JWT_SECRET_MIN_32_CHARS_DISTINCT
TWO_FACTOR_JWT_SECRET=CHANGE_ME_2FA_SECRET
PASSWORD_RESET_SECRET=CHANGE_ME_PASSWORD_RESET_SECRET
OAUTH_STATE_SECRET=CHANGE_ME_OAUTH_STATE_SECRET
ANALYTICS_HMAC_SECRET=CHANGE_ME_ANALYTICS_HMAC_SECRET
MT5_CREDENTIAL_SECRET=CHANGE_ME_MT5_CREDENTIAL_SECRET
AI_QUORUM_HMAC_SALT=CHANGE_ME_AI_QUORUM_SALT
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=CHANGE_ME
QUANT_ENGINE_URL=http://127.0.0.1:8001
QUANT_INTERNAL_KEY=CHANGE_ME_QUANT_INTERNAL_KEY

# --- OAuth ---
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# --- Mail (SMTP) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=CHANGE_ME
MAIL_PASS=CHANGE_ME
MAIL_FROM=noreply@example.com

# --- Payments ---
WEBHOOK_SECRET=CHANGE_ME
USD_TO_MZN_RATE=65
PLANO_BASICO_PRICE=9
PLANO_PRO_PRICE=19
PLANO_PREMIUM_PRICE=39

# --- Brokers & Market Data ---
DERIV_APP_ID=CHANGE_ME
DERIV_ENCRYPTION_KEY=CHANGE_ME_32_BYTES
MT5_TCP_PORT=3003
MT5_DEDICATED_SERVER=false
MT5_TEMPLATE_PATH=C:\MT5_TEMPLATE
MT5_DEMO_FEED_LOGIN=
MT5_DEMO_FEED_PASSWORD=
MT5_DEMO_FEED_SERVER=MetaQuotes-Demo
WORKER_ID=worker-1
WORKER_KEY=CHANGE_ME

# --- Web Push Notifications (VAPID RFC 8292) ---
VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC_BASE64URL
VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE_BASE64URL
VAPID_SUBJECT=mailto:suporte@torexjournal.com

# --- AI & Notifications ---
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-2.5-flash
QWEN_API_KEY=CHANGE_ME
QWEN_MODEL=qwen-plus
RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://localhost:5672

# --- Referrals & Growth ---
REFERRAL_VERIFY_CREDIT_USD=2
REFERRAL_PAID_CREDIT_USD=8
